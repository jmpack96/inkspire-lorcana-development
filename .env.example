# Required by every runtime process.
DATABASE_URL=postgresql://user:password@localhost:5432/lorcana
LORCANA_ENV=development

# Discord bot only.
DISCORD_BOT_TOKEN=
LORCANA_DISCORD_TEAM_SLUG=inkspire
# Optional. Set this on both the worker and bot to enable strict live-event links.
# LORCANA_LIVE_EVENT_CHANNEL_ID=123456789012345678

# Coach. Leave LORCANA_COACH_ANALYZER unset to disable Coach commands.
LORCANA_COACH_ANALYZER=openai
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-terra
# Optional explicit version label. If omitted, one is derived from the model.
# LORCANA_COACH_ANALYZER_GENERATION=

# Duels credentials are referenced by name from duels_connections; tokens are never stored in PostgreSQL.
# DUELS_TOKEN_JACOB=

# Worker tuning.
LORCANA_JOB_LEASE_SECONDS=900
LORCANA_WORKER_POLL_SECONDS=5
